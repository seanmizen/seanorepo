{
  "name": "seanorepo",
  "type": "module",
  "version": "0.0.1",
  "description": "monorepo for all sites, projects, etc",
  "main": "index.js",
  "repository": "https://github.com/seanmizen/seanorepo",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*",
    "utils/*"
  ],
  "scripts": {
    "sean": "yarn workspace seanmizen.com start",
    "caroline": "yarn workspace carolinemizen.art start",
    "cards": "yarn workspace seanscards start",
    "inside": "yarn workspace inside start",
    "gosniff": "yarn workspace gosniff start",
    "converter": "yarn workspace ffmpeg-converter start",
    "voxel": "yarn workspace swindowzig native:voxel",
    "voxel:web": "yarn workspace swindowzig dev:voxel",
    "ascii": "node utils/image-to-ascii/src/cli.mjs",
    "ascii-go": "go run -C utils/image-to-ascii ./cmd/image-to-ascii",
    "start:docker": "yarn workspaces foreach -Apt run start:docker",
    "prod:docker": "yarn workspaces foreach -At --exclude ffmpeg-converter --exclude seanscards run prod:docker",
    "down": "yarn workspaces foreach -Apt run down",
    "check": "biome check .",
    "fix": "biome check --write .",
    "requirements:check": "node requirements/check.mjs",
    "requirements:build": "node requirements/check.mjs --write",
    "format": "biome format --write .",
    "release": "bash scripts/promote-release.sh",
    "prepare": "husky",
    "tofu": "infra/cloudflare/tofu"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@commitlint/cli": "^20.5.0",
    "husky": "^9.1.7"
  },
  "dependenciesMeta": {
    "puppeteer": {
      "built": true
    }
  }
}
