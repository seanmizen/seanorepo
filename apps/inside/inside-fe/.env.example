# inside-fe. Copy to .env. .gitignore excludes .env.
# rsbuild reads this file at BUILD time. A change needs a rebuild to reach the
# browser. Every value enters the bundle. Keep secrets out of this file.

# Where the frontend sends /api calls. rsbuild.config.ts defaults it to '/api'.
# cloudflared routes /api to the backend on the same origin, so production
# needs no .env for this workspace.
#   local dev:  http://localhost:4061/api
#   production: unset, or /api
API_URL=http://localhost:4061/api

# playwright.config.ts reads CI to set retries and workers. The runner sets it.
# Do not set it here.
