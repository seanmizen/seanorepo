# ---------------------------------------------------------------------------
# inside-be — copy to .env and fill in. .env is gitignored; never commit it.
#
# Every key this file lists is read by apps/inside/inside-be/src. A key with a
# default works unset. Comments live at column 0 and never trail a value: the
# whole of a line after the first '=' is the value.
# ---------------------------------------------------------------------------

# NODE_ENV is deliberately NOT set here: the Dockerfile sets it per build
# target, and this file is loaded over the top of that. Leave it unset locally
# (which behaves as development).
PORT=4061

# Reported by GET /api/health and nothing else. Defaults to 0.1.0.
#APP_VERSION=0.1.0

# Directory holding database.db. Docker sets this to /app/db (a named volume).
DB_PATH=.

# Frontend origin — used for CORS and for building magic-link URLs.
FRONTEND_URL=http://localhost:4060
CORS_ORIGIN=http://localhost:4060

# Secrets. The server refuses to boot in production if these are unset or
# still the dev default.
JWT_SECRET=dev-secret-change-in-production
COOKIE_SECRET=dev-secret-change-in-production

# --- Asset storage -----------------------------------------------------------
# 'local' writes to UPLOADS_PATH. 's3' is stubbed for the future swap.
STORAGE_TYPE=local
# Docker sets this to /app/uploads (a named volume).
UPLOADS_PATH=./uploads
# Must match the fastify-static prefix, which is /api/uploads.
UPLOADS_URL=http://localhost:4061/api/uploads

UPLOAD_MAX_FILE_SIZE_MB=50
UPLOAD_MAX_FILES=30

# Images one owner may hold before an upload is refused. Defaults to 500.
#IMAGE_QUOTA_PER_USER=500

# --- Email (magic links) -----------------------------------------------------
# THE NAMES ARE SMTP_USER AND SMTP_PASS. Not SMTP_USERNAME, not SMTP_PASSWORD.
# Production had them as SMTP_USERNAME/SMTP_PASSWORD for an unknown length of
# time (#355): the credentials were correct, the server could not see them,
# isEmailConfigured() was false, and every sign-in attempt returned 502. Nothing
# warns about a key nobody reads. tcp-getter in this same repo uses
# MAIL_USERNAME/MAIL_PASSWORD, which is how the wrong pair looked plausible.
#
# Leave SMTP_USER/SMTP_PASS blank in development: with no working credentials
# the server surfaces the sign-in link on /login instead of failing to send.
# In production that fallback is refused, so blank credentials there mean
# nobody can sign in at all.
#
# A Gmail address needs an app password in SMTP_PASS, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The From address on a magic-link mail. Falls back to SMTP_USER, which is what
# you want unless the sending account and the visible sender differ.
#SMTP_FROM=

# Comma-separated emails that get the 'admin' role on login.
ADMIN_EMAILS=sean@seanmizen.com

# Dev only: return the sign-in link in the HTTP response instead of emailing
# it. Outside production this also happens automatically when SMTP is not
# configured, so local dev works with this left at false.
#
# This is a COMPLETE AUTHENTICATION BYPASS. The server refuses to boot if it is
# set with NODE_ENV=production.
DANGEROUS_BYPASS_EMAIL_MAGIC_LINK=false

# --- Site copy ---------------------------------------------------------------
SITE_NAME=inside.space
TAGLINE=Find the designer for your space
