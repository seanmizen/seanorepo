# inside-be. Copy to .env. .gitignore excludes .env. Never commit it.
# apps/inside/inside-be/src reads every key here.
# A comment starts at column 0. The value is everything after the first '='.

# The dockerfile sets NODE_ENV per build target, and this file loads over it.
# Leave it unset in production.
PORT=4061

# GET /api/health reports APP_VERSION. Nothing else reads it. It defaults to
# 0.1.0.
#APP_VERSION=0.1.0

# The directory that holds database.db. Docker sets it to /app/db.
DB_PATH=.

# The site origin. The server builds magic-link URLs from it.
FRONTEND_URL=http://localhost:4060
# The CORS allow-list.
CORS_ORIGIN=http://localhost:4060

# The server stops at startup in production when these are unset or still hold
# the dev default.
JWT_SECRET=dev-secret-change-in-production
COOKIE_SECRET=dev-secret-change-in-production

# 'local' writes to UPLOADS_PATH. The s3 provider is a stub.
STORAGE_TYPE=local
# Docker sets UPLOADS_PATH to /app/uploads.
UPLOADS_PATH=./uploads
# UPLOADS_URL must match the fastify-static prefix, which is /api/uploads.
UPLOADS_URL=http://localhost:4061/api/uploads
UPLOAD_MAX_FILE_SIZE_MB=50
UPLOAD_MAX_FILES=30
# The images one owner may hold before the server refuses an upload. It
# defaults to 500.
#IMAGE_QUOTA_PER_USER=500

# The keys are SMTP_USER and SMTP_PASS. Production used SMTP_USERNAME and
# SMTP_PASSWORD, so isEmailConfigured() read false and every sign-in returned
# 502 (#355). Nothing warns about a key that no code reads. tcp-getter uses
# MAIL_USERNAME and MAIL_PASSWORD. Check the name against the app.
#
# Leave SMTP_USER and SMTP_PASS blank in development. The server then shows the
# sign-in link on /login instead of failing to send. Production refuses to show
# the link, so blank credentials there stop every sign-in.
#
# Gmail needs an app password in SMTP_PASS, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The From address on a magic-link mail. It falls back to SMTP_USER. Set it
# only when the sending account and the visible sender differ.
#SMTP_FROM=

# Comma-separated. These addresses get the admin role at login.
ADMIN_EMAILS=sean@seanmizen.com

# 'true' returns the sign-in link instead of sending it. This bypasses
# authentication. The server refuses to start with NODE_ENV=production.
DANGEROUS_BYPASS_EMAIL_MAGIC_LINK=false

SITE_NAME=inside.space
TAGLINE=Find the designer for your space
