# Build context is always the monorepo root (see docker-compose.yml).

# deps — install the backend's dependencies standalone rather than as a
# workspace. The image needs no native build toolchain: SQLite comes from
# bun:sqlite, which is part of the runtime.
FROM node:23-slim AS deps
WORKDIR /app
COPY package.json .yarnrc.yml ./
# Overwrite the root package.json with the backend's so this resolves
# standalone instead of pulling in the whole monorepo.
COPY apps/inside/inside-be/package.json ./package.json
RUN corepack enable && corepack prepare yarn@4.18.0 && yarn install

# dev — node_modules sits at /app, so docker-compose fills its named volume
# from this image. The source arrives through the bind mount. Module
# resolution walks up from the working directory to find node_modules.
FROM oven/bun:latest AS dev
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
WORKDIR /app/apps/inside/inside-be
ENV NODE_ENV=development
EXPOSE 4061
CMD ["bun", "--hot", "--no-clear-screen", "src/index.ts"]

# prod — Bun runs the TypeScript directly. There is no bundling step, by design.
FROM oven/bun:latest AS prod
WORKDIR /app
# The whole `inside` workspace, so `@shared/*` (../shared) resolves.
COPY apps/inside ./apps/inside
# After the source, so it isn't clobbered by the copy above.
COPY --from=deps /app/node_modules ./node_modules
WORKDIR /app/apps/inside/inside-be
ENV NODE_ENV=production
EXPOSE 4061
CMD ["bun", "./src/index.ts"]
