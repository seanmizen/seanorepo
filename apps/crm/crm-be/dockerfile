# Build context is the monorepo root (see docker-compose.yml).

# deps: install the backend's dependencies standalone, not as a workspace.
# The image needs no native build toolchain. SQLite comes from bun:sqlite,
# which is part of the runtime.
FROM node:24-slim AS deps
WORKDIR /app
COPY package.json .yarnrc.yml ./
COPY .yarn/releases ./.yarn/releases
# Replace the root package.json with the backend's, so that the install does
# not pull in the whole monorepo.
COPY apps/crm/crm-be/package.json ./package.json
RUN yarn install

# dev: node_modules is at /app, so docker-compose fills its named volume from
# this image. The source comes in through the bind mount. Module resolution
# goes up from the working directory to find node_modules.
FROM oven/bun:latest AS dev
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
WORKDIR /app/apps/crm/crm-be
ENV NODE_ENV=development
EXPOSE 4101
CMD ["bun", "--hot", "--no-clear-screen", "src/index.ts"]
