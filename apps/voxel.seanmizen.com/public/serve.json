{
  "headers": [
    {
      "source": "**",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "chunks-*.wasm",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "chunk-worker-*.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
