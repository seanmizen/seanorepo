# syntax=docker/dockerfile:1.6
#
# voxel.seanmizen.com — browser voxel, served over Cloudflared tunnel.
#
# Three stages:
#   1. zig-build  — download the Zig version that build.zig.zon names, and
#                   build the voxel example of the swindowzig release that
#                   build.zig.zon names to WASM. Zig fetches the release
#                   (network access at build time).
#   2. js-build   — bundle.sh: Bun bundles boot.js and the chunk worker, and
#                   the chunk files get content-hashed names
#   3. prod       — copy the static output into a minimal Node image and run `serve`
#
# The dev target is a no-op: for dev you'd run `yarn build` locally and open the dist
# folder with your usual static server. Docker dev mode just keeps an interactive shell
# alive so `docker compose --profile dev up` doesn't flap.

# =============================================================================
# Stage 1: Zig WASM build
# =============================================================================
FROM debian:bookworm-slim AS zig-build
WORKDIR /build

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates xz-utils \
    && rm -rf /var/lib/apt/lists/*

# The Zig version comes from minimum_zig_version in build.zig.zon, the one
# place that names it. build.zig stops on any other major.minor. The tarball
# name is zig-ARCH-linux-VERSION (Zig 0.15 and later).
COPY apps/voxel.seanmizen.com/build.zig.zon /tmp/build.zig.zon
ARG TARGETARCH
RUN set -e; \
    ZIG_VERSION="$(sed -n 's/.*\.minimum_zig_version = "\([^"]*\)".*/\1/p' /tmp/build.zig.zon)"; \
    [ -n "${ZIG_VERSION}" ] || { echo "build.zig.zon has no minimum_zig_version" >&2; exit 1; }; \
    case "${TARGETARCH:-$(uname -m)}" in \
      arm64|aarch64) ZIG_ARCH=aarch64 ;; \
      *) ZIG_ARCH=x86_64 ;; \
    esac; \
    curl -fsSL "https://ziglang.org/download/${ZIG_VERSION}/zig-${ZIG_ARCH}-linux-${ZIG_VERSION}.tar.xz" \
    | tar -xJ \
    && mv "zig-${ZIG_ARCH}-linux-${ZIG_VERSION}" /opt/zig \
    && ln -s /opt/zig/zig /usr/local/bin/zig \
    && zig version

# build.zig takes the voxel example from the swindowzig release
# (addWebExample). It writes app.wasm, chunks.wasm (the chunk worker) and
# zig-out/swindowzig-wasm/ (the wasm loader of the same release).
COPY apps/voxel.seanmizen.com/build.zig apps/voxel.seanmizen.com/build.zig.zon /build/voxel/
WORKDIR /build/voxel
RUN zig build -Dexample=voxel -Doptimize=ReleaseFast && ls -la zig-out/bin/

# =============================================================================
# Stage 2: JS bundle (Bun)
# =============================================================================
# bundle.sh (the script that build.sh runs too) makes /build/out/:
#   boot.js                 apps/voxel.seanmizen.com/src/boot.ts and the
#                           swindowzig wasm loader (backends/wasm/loader.ts)
#   chunk-worker-<hash>.js  the chunk worker (backends/wasm/chunk-worker.ts)
#   chunks-<hash>.wasm      chunks.wasm from stage 1
# The chunk files have content-hashed names, and boot.js holds the names
# (C9). The COPY below takes all of backends/wasm of the release, from
# stage 1.
FROM oven/bun:1.1-slim AS js-build
WORKDIR /build

COPY --from=zig-build /build/voxel/zig-out/swindowzig-wasm /build/apps/voxel.seanmizen.com/zig-out/swindowzig-wasm
COPY apps/voxel.seanmizen.com/src /build/apps/voxel.seanmizen.com/src
COPY apps/voxel.seanmizen.com/tsconfig.json /build/apps/voxel.seanmizen.com/tsconfig.json
COPY apps/voxel.seanmizen.com/bundle.sh /build/apps/voxel.seanmizen.com/bundle.sh
COPY --from=zig-build /build/voxel/zig-out/bin/chunks.wasm /build/chunks.wasm

RUN bash /build/apps/voxel.seanmizen.com/bundle.sh /build/chunks.wasm /build/out \
    && ls -la /build/out

# =============================================================================
# Stage 3: Production runtime — static file server
# =============================================================================
FROM node:24-slim AS prod
WORKDIR /app

# `serve` is a tiny static server with correct MIME types for .wasm — the same
# tool seanmizen.com uses in its prod stage.
RUN npm install -g serve

# Copy the static assets (index.html etc.) and overlay freshly-built artefacts.
COPY apps/voxel.seanmizen.com/public /app
# boot.js, chunk-worker-<hash>.js and chunks-<hash>.wasm.
COPY --from=js-build /build/out/ /app/
COPY --from=zig-build /build/voxel/zig-out/bin/app.wasm /app/app.wasm

EXPOSE 4042
CMD ["serve", "-s", ".", "-l", "4042"]

# =============================================================================
# Dev target — kept minimal so `docker compose --profile dev up` has something
# to point at. The real dev loop for this app is the dev server of the
# swindowzig repo (https://github.com/seanmizen/swindowzig), run on the host.
# =============================================================================
FROM node:24-slim AS dev
WORKDIR /app
# Source is mounted in via docker-compose's bind mount.
CMD ["sh", "-c", "echo 'voxel.seanmizen.com dev: run yarn dev:voxel in a checkout of the swindowzig repo on the host instead' && tail -f /dev/null"]
