{
  "name": "tcp-getter",
  "packageManager": "yarn@4.8.1",
  "scripts": {
    "start": "concurrently -n build,run -c blue,green 'rslib build --watch' 'node --watch --env-file=.env dist/index.mjs'",
    "build": "rslib build",
    "prod": "NODE_ENV=production node --env-file=.env dist/index.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "fastify": "^5.6.2",
    "nodemailer": "^7.0.11"
  },
  "devDependencies": {
    "@rslib/core": "^0.18.3",
    "@types/node": "^22.19.1",
    "@types/nodemailer": "^7.0.4",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
