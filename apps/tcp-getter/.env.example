# tcp-getter. Copy to .env. .gitignore excludes .env. Never commit it.
# index.ts reads every key here. validateEnvVars() stops the service at startup
# when a REQUIRED key is unset.
#
# This service emails you the current ngrok address and an SSH command that
# pins the host key. ngrok is the only route in from off the LAN
# (REQ-NETWORK-005). A broken .env here costs you remote access.

# REQUIRED. The origin that CORS allows: the site that serves the request form.
SITE_BASE_URL=https://seanmizen.com
# REQUIRED. There is no default.
PORT=4120

# The address to bind. Loopback by default, and it should stay that way:
# cloudflared reaches this service at http://localhost:4120, and the route it
# serves hands out an SSH address. Anything else breaks REQ-SERVER-002, which
# allows only ports 22, 80, 443 and 5353 on a routable address.
#HOST=127.0.0.1

# The keys are MAIL_USERNAME and MAIL_PASSWORD. caroline-be and inside-be use
# SMTP_USER and SMTP_PASS. This file is the odd one out. inside-be used
# SMTP_USERNAME and SMTP_PASSWORD, and its sign-in returned 502 until #355.
# Check the name against the app.
#
# REQUIRED unless MAIL_DRY_RUN is true. Gmail needs an app password in
# MAIL_PASSWORD, not the account password.
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-here

# REQUIRED. Comma-separated. The service refuses any other address and sends no
# mail. An empty list stops the service at startup.
EMAIL_WHITELIST=your-email@example.com

# 'true' prints the mail to stdout instead of sending it, and drops the
# requirement for MAIL_USERNAME and MAIL_PASSWORD. Use it to read the
# connection string without SMTP credentials.
MAIL_DRY_RUN=false

# The account that the emailed command logs in as.
SSH_USERNAME=srv
# The path that the emailed command names for your private key. This service
# never reads the key. It defaults to ~/id_ed25519.
#CLIENT_KEY_PATH=~/id_ed25519
# The PUBLIC half of this machine's SSH host key. The service reads it so the
# emailed command can pin it. It defaults to
# /etc/ssh/ssh_host_ed25519_key.pub.
#HOST_KEY_FILE=/etc/ssh/ssh_host_ed25519_key.pub

# The local ngrok agent's inspector API. It defaults to
# http://127.0.0.1:4040/api/tunnels. ngrok binds port 4040 by default, so no
# service in this repo may use it.
#
# tcp-getter runs as a host unit (custom-tcp-getter.service), so it reaches the
# agent on loopback. ngrok binds the inspector to 127.0.0.1:4040 by default and
# this generation keeps that default, so leave this key unset. #359.
NGROK_API_URL=http://127.0.0.1:4040/api/tunnels

# 'true' returns a fixed fake tunnel address instead of asking ngrok. It lets
# you test the mail path with no agent running.
MOCK_TCP_TUNNEL=false
