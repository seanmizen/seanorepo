# ---------------------------------------------------------------------------
# tcp-getter — copy to .env and fill in. .env is gitignored; never commit it.
#
# This service emails you the current ngrok address and the SSH command to
# reach this machine, host key pinned. It is the only route in from off the LAN
# (REQ-NETWORK-005), so a broken .env here costs you remote access.
#
# Every key is read by index.ts. validateEnvVars() refuses to start without the
# ones marked REQUIRED. Comments live at column 0 and never trail a value.
# ---------------------------------------------------------------------------

# REQUIRED. Origin allowed through CORS: the site the request form is served
# from.
SITE_BASE_URL=https://seanmizen.com

# REQUIRED. No default; the service will not start without it.
PORT=4120

# --- Mail --------------------------------------------------------------------
# THE NAMES HERE ARE MAIL_USERNAME AND MAIL_PASSWORD, which disagrees with
# caroline-be and inside-be: those two use SMTP_USER and SMTP_PASS. The
# disagreement is real and this file is the odd one out. inside-be's production
# .env was written with SMTP_USERNAME/SMTP_PASSWORD and its sign-in returned 502
# until #355, so check the name against the app before filling one of these in.
#
# REQUIRED unless MAIL_DRY_RUN is true. A Gmail address needs an app password
# in MAIL_PASSWORD, not the account password.
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-here

# REQUIRED. Comma-separated. A request for any other address is refused, and no
# mail is sent. An empty list stops the service starting.
EMAIL_WHITELIST=your-email@example.com

# Dev only: print the mail to stdout instead of sending it, which also drops
# the requirement for MAIL_USERNAME and MAIL_PASSWORD. Use it to read the
# connection string without SMTP credentials.
MAIL_DRY_RUN=false

# --- SSH details the mail quotes ---------------------------------------------
# The account the emailed command logs in as.
SSH_USERNAME=srv

# Where the emailed command tells you your private key is. This service never
# reads the key; the path is text in the mail. Defaults to ~/id_ed25519.
#CLIENT_KEY_PATH=~/id_ed25519

# The PUBLIC half of this machine's SSH host key, read so the emailed command
# can pin it. docker-compose.yml bind-mounts this path read-only; the private
# key is never mounted. Defaults to /etc/ssh/ssh_host_ed25519_key.pub.
#HOST_KEY_FILE=/etc/ssh/ssh_host_ed25519_key.pub

# --- ngrok -------------------------------------------------------------------
# The local ngrok agent's inspector API. Port 4040 is ngrok's own default and
# is reserved for it across this repo, which is why no service may bind it.
# Defaults to http://127.0.0.1:4040/api/tunnels.
NGROK_API_URL=http://host.docker.internal:4040/api/tunnels

# Dev only: return a fixed fake tunnel address instead of asking ngrok, so the
# mail path can be tested with no agent running.
MOCK_TCP_TUNNEL=false
