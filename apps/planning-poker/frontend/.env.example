# ---------------------------------------------------------------------------
# planning-poker frontend — copy to .env. .env is gitignored.
#
# Read by rsbuild.config.ts at BUILD time, which maps each key to an
# import.meta.env.PUBLIC_* define. A change here needs a rebuild to reach the
# browser, and every value ends up in the bundle: nothing secret belongs here.
#
# Every key is a switch. 'true' turns it on; anything else, including unset,
# leaves it off. Every one is off in production, so debbie carries no .env for
# this workspace at all and does not need one.
# ---------------------------------------------------------------------------

# Shows the backend connection state in the UI.
DEBUG_BACKEND=false

# Shows the countdown on the snackbar.
DEBUG_SHOW_SNACKBAR_TIMER=false

# Shows a manual refresh button.
DEBUG_SHOW_REFRESH_BUTTON=false

# Shows each attendee's id next to their name.
DEBUG_SHOW_ATTENDEE_ID=false

# Reports WebSocket updates in the snackbar. Useful when sync looks wrong.
DEBUG_WS_UPDATES=false

# Hides the "Copy URL" button, which an embedded instance does not want.
HIDE_COPY_URL_BUTTON=false

# SHOW_DISCLAIMER is read by src/config/env.ts as PUBLIC_SHOW_DISCLAIMER, but
# rsbuild.config.ts does not define it, so setting it here does nothing. See
# issue #351. Left documented rather than deleted so the next person does not
# rediscover it.
#SHOW_DISCLAIMER=false
