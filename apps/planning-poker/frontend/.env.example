# planning-poker frontend. Copy to .env. .gitignore excludes .env.
# rsbuild.config.ts reads this file at BUILD time and maps each key to an
# import.meta.env.PUBLIC_* define. A change needs a rebuild to reach the
# browser. Every value enters the bundle. Keep secrets out of this file.
#
# Every key is a switch. 'true' turns it on. Any other value, and unset, turns
# it off. Production turns all of them off, so production needs no .env for
# this workspace.

# Shows the backend connection state.
DEBUG_BACKEND=false
# Shows the countdown on the snackbar.
DEBUG_SHOW_SNACKBAR_TIMER=false
# Shows a manual refresh button.
DEBUG_SHOW_REFRESH_BUTTON=false
# Shows each attendee's id next to their name.
DEBUG_SHOW_ATTENDEE_ID=false
# Reports WebSocket updates in the snackbar.
DEBUG_WS_UPDATES=false
# Hides the "Copy URL" button. An embedded instance wants this.
HIDE_COPY_URL_BUTTON=false

# src/config/env.ts reads PUBLIC_SHOW_DISCLAIMER, but rsbuild.config.ts defines
# no such key, so SHOW_DISCLAIMER does nothing. See #351.
#SHOW_DISCLAIMER=false
