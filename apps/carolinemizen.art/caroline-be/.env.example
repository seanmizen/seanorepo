# ---------------------------------------------------------------------------
# caroline-be — copy to .env and fill in. .env is gitignored; never commit it.
#
# Every key this file lists is read by apps/carolinemizen.art/caroline-be/src.
# A key with a default works unset; a key marked REQUIRED IN PRODUCTION does
# not. Comments live at column 0 and never trail a value: the whole of a line
# after the first '=' is the value.
# ---------------------------------------------------------------------------

# --- Server ------------------------------------------------------------------
PORT=4021
# Unset behaves as development. The dockerfile sets this per build target and
# this file loads over the top, so leave it out of a production .env and let
# the image decide.
NODE_ENV=development

# --- Database ----------------------------------------------------------------
# Directory holding database.db, not the file itself. Docker sets this to
# /app/db, a named volume.
DB_PATH=.

# --- URLs --------------------------------------------------------------------
# API_URL is NOT read here. The old version of this file listed it, which was
# wrong: nothing under caroline-be/src reads it. It is a build arg for the
# frontend image, and docker-compose.yml takes it from the shell environment as
# ${API_URL:-/api}, never from this file. Set it in caroline-fe/.env, or leave
# it alone and take the /api default.
#
# Frontend origin. Used to build magic-link URLs and as the CORS allow-list.
FRONTEND_URL=http://localhost:4020
CORS_ORIGIN=http://localhost:4020

# --- Secrets -----------------------------------------------------------------
# REQUIRED IN PRODUCTION. Generate each with:
#   openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here
COOKIE_SECRET=your-cookie-secret-here

# --- Email (magic links) -----------------------------------------------------
# THE NAMES ARE SMTP_USER AND SMTP_PASS. Not SMTP_USERNAME, not SMTP_PASSWORD;
# inside-be's production .env used the latter pair and its sign-in returned 502
# until #355. tcp-getter in this same repo uses MAIL_USERNAME/MAIL_PASSWORD,
# which is how the wrong pair looks plausible.
#
# A Gmail address needs an app password here, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here

# --- Asset storage -----------------------------------------------------------
# 'local' writes to UPLOADS_PATH. Anything else logs a warning and falls back
# to local: there is no second provider yet.
STORAGE_TYPE=local
# Docker sets this to /app/uploads, a named volume.
UPLOADS_PATH=./uploads
# Must match the fastify-static prefix, which is /api/uploads.
UPLOADS_URL=http://localhost:4021/api/uploads
UPLOAD_MAX_FILE_SIZE_MB=100
UPLOAD_MAX_FILES=30

# --- Admin access ------------------------------------------------------------
# Comma-separated. These addresses get the admin role on login. The server
# refuses to start with this unset unless TEST_MODE is true.
ADMIN_EMAILS=your-admin@email.com,another-admin@email.com

# --- Site copy ---------------------------------------------------------------
SITE_NAME=Caroline Mizen Art
ADMIN_TITLE=Caroline Mizen Admin
DASHBOARD_WELCOME_TITLE=Welcome to Your Admin Panel
DASHBOARD_WELCOME_TEXT=Manage your artwork, galleries, and site content from this central hub.

# The four admin dashboard card descriptions. Each has a sensible default in
# src/controllers/config.ts, so leave them unset unless the wording is wrong.
#DASHBOARD_CARD_ARTWORKS=Manage your artwork collection, upload images, set prices, and control availability.
#DASHBOARD_CARD_GALLERIES=Create and organize galleries, group artworks into collections, and feature them on your homepage.
#DASHBOARD_CARD_IMAGES=Upload and manage all images used throughout the site for artworks and galleries.
#DASHBOARD_CARD_CONTENT=Edit site-wide content including hero text, about page, and other page content.

# --- Switches ----------------------------------------------------------------
# Exposes the debug routes in src/controllers/debug.ts, which generate sample
# data. Anything but 'true' leaves them off.
DEBUG_MODE=true

# COMPLETE AUTHENTICATION BYPASS. Returns the sign-in link instead of emailing
# it. Development only.
DANGEROUS_BYPASS_EMAIL_MAGIC_LINK=false

# Set by src/tests/setup.ts only. It relaxes the ADMIN_EMAILS start-up check,
# so it must never be set in a real .env.
#TEST_MODE=false
