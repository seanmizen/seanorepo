# caroline-be. Copy to .env. .gitignore excludes .env. Never commit it.
# apps/carolinemizen.art/caroline-be/src reads every key here.
# A comment starts at column 0. The value is everything after the first '='.

PORT=4021
# The dockerfile sets NODE_ENV per build target, and this file loads over it.
# Leave it unset in production.
NODE_ENV=development

# The directory that holds database.db. Docker sets it to /app/db.
DB_PATH=.

# docker-compose.yml passes API_URL to the frontend image as a build arg. It
# reads it from the shell, not from this file. Set it in caroline-fe/.env.

# The site origin. The server builds magic-link URLs from it.
FRONTEND_URL=http://localhost:4020
# The CORS allow-list.
CORS_ORIGIN=http://localhost:4020

# Production needs both. Generate each one: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here
COOKIE_SECRET=your-cookie-secret-here

# The keys are SMTP_USER and SMTP_PASS. inside-be used SMTP_USERNAME and
# SMTP_PASSWORD, and its sign-in returned 502 until #355. tcp-getter uses
# MAIL_USERNAME and MAIL_PASSWORD. Check the name against the app.
# Gmail needs an app password in SMTP_PASS, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here

# 'local' writes to UPLOADS_PATH. Any other value logs a warning and writes to
# UPLOADS_PATH. There is one provider.
STORAGE_TYPE=local
# Docker sets UPLOADS_PATH to /app/uploads.
UPLOADS_PATH=./uploads
# UPLOADS_URL must match the fastify-static prefix, which is /api/uploads.
UPLOADS_URL=http://localhost:4021/api/uploads
UPLOAD_MAX_FILE_SIZE_MB=100
UPLOAD_MAX_FILES=30

# Comma-separated. These addresses get the admin role at login. The server
# stops at startup when ADMIN_EMAILS is unset and TEST_MODE is not true.
ADMIN_EMAILS=your-admin@email.com,another-admin@email.com

SITE_NAME=Caroline Mizen Art
ADMIN_TITLE=Caroline Mizen Admin
DASHBOARD_WELCOME_TITLE=Welcome to Your Admin Panel
DASHBOARD_WELCOME_TEXT=Manage your artwork, galleries, and site content from this central hub.

# src/controllers/config.ts holds a default for each of the four dashboard card
# descriptions. Set one only to change its wording.
#DASHBOARD_CARD_ARTWORKS=
#DASHBOARD_CARD_GALLERIES=
#DASHBOARD_CARD_IMAGES=
#DASHBOARD_CARD_CONTENT=

# 'true' exposes the debug routes in src/controllers/debug.ts, which generate
# sample data. Any other value hides them.
DEBUG_MODE=true

# 'true' returns the sign-in link instead of sending it. This bypasses
# authentication. Use it in development only.
DANGEROUS_BYPASS_EMAIL_MAGIC_LINK=false

# src/tests/setup.ts sets TEST_MODE. It relaxes the ADMIN_EMAILS check at
# startup. Never set it in a real .env.
#TEST_MODE=false
