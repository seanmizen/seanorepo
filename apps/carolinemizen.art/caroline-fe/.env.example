# ---------------------------------------------------------------------------
# caroline-fe — copy to .env and fill in. .env is gitignored; never commit it.
#
# Read by rsbuild at BUILD time, not at run time. A change here needs a rebuild
# to reach the browser, and every value ends up in the bundle: nothing secret
# belongs in this file.
# ---------------------------------------------------------------------------

# Where the frontend sends /api calls. rsbuild.config.ts defaults it to '/api'
# when unset, which is the right answer in production — cloudflared routes /api
# to the backend on the same origin. debbie therefore carries no .env for this
# workspace at all, and does not need one.
#
# src/config/api.ts exports its own API_URL, computed from MODE and the window
# hostname rather than from this key. Both land on /api in production, so the
# two mechanisms agree today; the contexts and components read this one.
#   local dev:  http://localhost:4021/api
#   production: unset, or /api
API_URL=http://localhost:4021/api

# Site origin, used to build the shareable collection links the admin galleries
# page copies to the clipboard. Defaults to http://localhost:4020.
#PUBLIC_URL=https://carolinemizen.art

# Shows the debug menu, which generates sample data. It needs DEBUG_MODE=true
# on caroline-be as well: this switch only reveals the menu, the backend serves
# the routes it calls.
DEBUG_MODE=true

# MODE and NODE_ENV are read by src/config/api.ts to pick the API base. Both
# are set by rsbuild from the build target. Do not set either here.
