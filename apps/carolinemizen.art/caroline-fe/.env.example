# caroline-fe. Copy to .env. .gitignore excludes .env.
# rsbuild reads this file at BUILD time. A change needs a rebuild to reach the
# browser. Every value enters the bundle. Keep secrets out of this file.

# Where the frontend sends /api calls. rsbuild.config.ts defaults it to '/api'.
# cloudflared routes /api to the backend on the same origin, so production
# needs no .env for this workspace.
#   local dev:  http://localhost:4021/api
#   production: unset, or /api
API_URL=http://localhost:4021/api

# The site origin. The admin galleries page builds shareable collection links
# from it. It defaults to http://localhost:4020.
#PUBLIC_URL=https://carolinemizen.art

# 'true' shows the debug menu, which generates sample data. caroline-be needs
# DEBUG_MODE=true as well: this key reveals the menu, the backend serves the
# routes.
DEBUG_MODE=true

# src/config/api.ts reads MODE and NODE_ENV to pick the API base. rsbuild sets
# both from the build target. Do not set either one here.
