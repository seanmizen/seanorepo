# Build context is always the monorepo root (see ../docker-compose.yml).

# deps: install the backend's dependencies standalone, not as a workspace.
# SQLite comes from bun:sqlite, so the image needs no native toolchain.
FROM node:24-slim AS deps
WORKDIR /app
COPY package.json .yarnrc.yml ./
COPY .yarn/releases ./.yarn/releases
# The backend's package.json replaces the root one, so the install does not
# pull in the whole monorepo.
COPY apps/cous/cous-be/package.json ./package.json
RUN yarn install

# dev: docker-compose fills the node_modules volume from this image. The
# source comes through the bind mount.
FROM oven/bun:latest AS dev
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
WORKDIR /app/apps/cous/cous-be
ENV NODE_ENV=development
EXPOSE 4071
CMD ["bun", "--hot", "--no-clear-screen", "src/index.ts"]

# prod: Bun runs the TypeScript directly. There is no bundle step.
FROM oven/bun:latest AS prod
WORKDIR /app
COPY apps/cous/cous-be ./apps/cous/cous-be
COPY --from=deps /app/node_modules ./node_modules
WORKDIR /app/apps/cous/cous-be
ENV NODE_ENV=production
EXPOSE 4071
CMD ["bun", "./src/index.ts"]
