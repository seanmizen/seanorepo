{
  "name": "cous",
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "cous-be"
  ],
  "scripts": {
    "start": "yarn rsbuild dev --open",
    "start:noopen": "yarn rsbuild dev --port 4070",
    "start:all": "concurrently --prefix \"{time} {name} †\" -k -t \"HH:mm\" -n \"FE,BE\" -c \"green.bold,red.bold\" \"yarn start\" \"yarn workspace cous-be start\"",
    "start:docker": "PUBLISH_ADDR=0.0.0.0 docker compose --profile dev up --build",
    "prod:docker": "docker network create edge >/dev/null 2>&1; BUILD_TARGET=prod docker compose --profile prod up --build --detach",
    "build": "yarn && yarn rsbuild build",
    "test": "yarn workspace cous-be test",
    "test:types": "tsc --noEmit && yarn workspace cous-be tsc --noEmit",
    "down": "docker compose --profile dev --profile prod down"
  },
  "dependencies": {
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.6.13",
    "@rsbuild/plugin-react": "^1.4.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
