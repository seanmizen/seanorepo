# Multi-stage Dockerfile for the seansconverter.com backend (the Go service).
# The frontend has its own: web/dockerfile.
# Build context is the monorepo root (see docker-compose.yml).
#
# Targets:
#   dev   - `go run .` on the bind-mounted source.
#   prod  - a static binary on Debian 13 with Debian's ffmpeg.
#
# ffmpeg comes from Debian 13 (trixie), and every rebuild takes Debian's
# security updates. Debian's ffmpeg 7.1 reads only one tile of an iPhone
# photo, so libheif-examples decodes HEIC first (withHEIFDecode in ops.go).

FROM golang:1.25-trixie AS dev
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libheif-examples \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app/apps/ffmpeg-converter
ENV PORT=4051 DATA_DIR=/data
EXPOSE 4051
CMD ["go", "run", "."]


FROM golang:1.25-trixie AS prod-build
WORKDIR /src
COPY apps/ffmpeg-converter/go.mod apps/ffmpeg-converter/go.sum ./
RUN go mod download
COPY apps/ffmpeg-converter/*.go ./
# modernc.org/sqlite is pure Go, so the binary needs no C library.
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/ffmpeg-converter .


FROM debian:trixie-slim AS prod
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libheif-examples ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --home-dir /data converter \
    && install -d -o converter -g converter /data
COPY --from=prod-build /out/ffmpeg-converter /usr/local/bin/ffmpeg-converter
USER converter
ENV PORT=4051 DATA_DIR=/data
EXPOSE 4051
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD ["ffmpeg-converter", "-healthcheck"]
CMD ["ffmpeg-converter"]
