# ---------------------------------------------------------------------------
# seanscards — copy to .env and fill in. .env is gitignored; never commit it.
#
# NOTHING READS THIS FILE YET. docker-compose.yml sets DB_PATH inline and
# declares no env_file, so a .env beside it is ignored in both dev and prod.
# See issue #352, which wires it up and takes the hardcoded Stripe key out of
# backend/index.ts. Until then this file documents what the backend reads, so
# the keys are inventoried rather than discovered.
#
# Confirmed on the live machine: debbie holds no .env for this workspace, which
# is consistent — there has never been anything to read one. Production has
# always run on the key hardcoded in the source.
#
# Read by apps/seanscards/backend/{index,db}.ts.
# ---------------------------------------------------------------------------

# Chooses the block in apps/seanscards/configs.ts: 'development' or
# 'production'. That block carries the domain, the Stripe price id and the
# publishable key. Defaults to development. The dockerfile sets this per build
# target, so leave it out of a production .env and let the image decide.
NODE_ENV=development

# Listen port. Defaults to the serverPort in configs.ts, which is 4011.
PORT=4011

# Directory holding the sqlite file, not the file itself: db.ts joins the
# dbName from configs.ts onto it (dev.sqlite or staging.sqlite). Defaults to
# the backend source directory. docker-compose.yml sets it to /app/db, a named
# volume.
DB_PATH=.

# --- Stripe ------------------------------------------------------------------
# REQUIRED ONCE #352 LANDS. The secret key, sk_test_… or sk_live_…, from
# https://dashboard.stripe.com/apikeys. It must match the mode of the
# publishable key and price id in configs.ts for the NODE_ENV above: a test
# secret key cannot take a live payment.
#
# index.ts currently falls back to a test key hardcoded in the source. That
# fallback is the bug #352 removes; do not rely on it.
STRIPE_SECRET_KEY=sk_test_...
