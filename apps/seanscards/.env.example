# seanscards. Copy to .env. .gitignore excludes .env. Never commit it.
# apps/seanscards/backend/{index,db}.ts reads every key here.
#
# NOTHING READS THIS FILE. docker-compose.yml sets DB_PATH inline and declares
# no env_file, so docker ignores a .env beside it in dev and in prod. debbie
# holds no .env for this workspace either. #352 deletes the Stripe key that
# index.ts falls back to, because the app is not live and not supported.
# This file records the keys until then.

# Selects the block in apps/seanscards/configs.ts: 'development' or
# 'production'. That block holds the domain, the Stripe price id and the
# publishable key. It defaults to development. The dockerfile sets NODE_ENV per
# build target, so leave it unset in production.
NODE_ENV=development

# The listen port. It defaults to the serverPort in configs.ts, which is 4011.
PORT=4011

# The directory that holds the sqlite file. db.ts joins the dbName from
# configs.ts onto it: dev.sqlite or staging.sqlite. It defaults to the backend
# source directory. docker-compose.yml sets it to /app/db.
DB_PATH=.

# The Stripe secret key, sk_test_… or sk_live_…, from
# https://dashboard.stripe.com/apikeys. It must match the mode of the
# publishable key and price id that configs.ts holds for the NODE_ENV above. A
# test secret key cannot take a live payment.
STRIPE_SECRET_KEY=sk_test_...
