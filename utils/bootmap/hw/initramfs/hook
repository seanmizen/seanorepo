#!/bin/sh
# initramfs-tools hook (bootmap, hw/install.sh): put bootmapd in the initramfs.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac
. /usr/share/initramfs-tools/hook-functions
[ -x /usr/local/lib/bootmap/bootmapd ] || exit 0
# A static binary: no libraries to copy.
mkdir -p "$DESTDIR/usr/local/lib/bootmap"
cp /usr/local/lib/bootmap/bootmapd "$DESTDIR/usr/local/lib/bootmap/bootmapd"
