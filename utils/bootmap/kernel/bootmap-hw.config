# Merged onto a real machine's own Debian config by kernel/build-deb.sh.
# kernel/bootmap.config is for the QEMU kernel. This one keeps the machine's
# drivers, and changes only what bootmap needs.
CONFIG_BOOTMAP=y
# The daemon draws through DRM on simpledrm, the firmware framebuffer. It
# must exist before the GPU driver (i915 and others load later).
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
# CONFIG_FB_EFI is not set
# Keep the text console, but it takes the screen only at the first text
# (with quiet: the login prompt), not when simpledrm starts.
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
# The daemon writes the initcall times to an EFI variable.
CONFIG_EFIVAR_FS=y
# The GPU driver (i915 and others) stays a module. hw/install.sh holds it
# back until bootmapd gives the screen to the console, then bootmapd loads it
# (bootmap.gpu=). So simpledrm keeps the screen for the whole picture.
