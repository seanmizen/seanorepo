# Merged onto x86_64_defconfig and kvm_guest.config by fetch-and-build.sh.
CONFIG_BOOTMAP=y
# Nothing else draws on the framebuffer: no framebuffer console.
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# The daemon draws through DRM on simpledrm (the firmware framebuffer).
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_SERIAL_8250_CONSOLE=y
