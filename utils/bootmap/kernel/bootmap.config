# Merged onto x86_64_defconfig and kvm_guest.config by fetch-and-build.sh.
CONFIG_BOOTMAP=y
# Nothing else draws on the framebuffer: no framebuffer console.
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# The daemon draws through DRM on simpledrm (the firmware framebuffer).
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_SERIAL_8250_CONSOLE=y
# The full test (vm/run.sh --full) boots the Debian 13 cloud image with this
# kernel and no initramfs. systemd wants these.
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_FANOTIFY=y
CONFIG_TMPFS_XATTR=y
CONFIG_FHANDLE=y
CONFIG_EFIVAR_FS=y
CONFIG_AUTOFS_FS=y
# The guest runs the daemon from a host folder (9p), so a new daemon needs
# no change to the disk image.
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
