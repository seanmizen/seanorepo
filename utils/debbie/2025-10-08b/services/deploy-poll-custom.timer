[Unit]
Description=Poll origin/release every couple of minutes and deploy on change
Documentation=https://github.com/seanmizen/seanorepo/issues/256

[Timer]
# Later than deployment-custom.service's boot run, which is doing the same work.
# They share a flock either way, so an overlap is a no-op rather than a clash.
OnBootSec=3min
OnUnitActiveSec=2min
AccuracySec=30s
Unit=deploy-poll-custom.service

[Install]
WantedBy=timers.target
