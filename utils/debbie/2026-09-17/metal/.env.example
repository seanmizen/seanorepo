# metal/.env: one box. Copy to .env. Gitignored: keep it that way.
# Read by: build-iso.sh, serve-preseed.sh, provision.sh (lib.sh read_env).
# Literal, not sourced: no escaping, quotes optional. Unknown key = error.
# Unset never switches anything on. Required + unset = script stops.

# REQUIRED. Hostname; box answers as <name>.local. No default.
SERVER_NAME=
# Sudo + SSH account. Default srv.
DEPLOY_USER=srv
# REQUIRED. Console password hash: openssl passwd -6
PASSWORD_CRYPTED=

# ROLES. Unset/empty/no = OFF. provision.sh makes the box match this file.
# Runs the sites. Without TUNNEL: published on LAN.
#ROLE_WEBSERVER=yes
# Runs Cloudflare tunnel. Needs WEBSERVER. Sites on loopback. ONE box only.
#ROLE_TUNNEL=yes

# REQUIRED. Wifi, goes on the installer kernel cmdline.
WIFI_SSID=
WIFI_PASS=
# Target wifi interface, e.g. wlp2s0. Blank = pick at the prompt.
WIFI_IFACE=

# OPTIONAL.
# SSH private key. Default metal/work/id_ed25519 (generated).
SSH_KEY=
# netinst ISO. Default newest in metal/work/ or ~/Downloads/.
ISO=
# Preseed server port; fetch address if autodetect fails.
PORT=8000
SERVE_IP=

# Not here: HOST=<ip> ./provision.sh if <name>.local won't resolve.
