# Copy to .env and fill in. .env is gitignored and must stay that way: it holds
# a password hash and a wifi passphrase.
#
# This file is parsed literally, not sourced as shell. Values are taken exactly
# as written, so a hash full of '$' needs no escaping and quotes are optional.
# An unrecognised key is an error rather than a line that silently does nothing.

# The account that gets sudo and the SSH key.
DEPLOY_USER=srv
SERVER_NAME=debbie

# sha512-crypt hash for DEPLOY_USER. Generate with:
#   openssl passwd -6
# Nothing in the repository holds a hash; the generator refuses to run without
# this being set.
PASSWORD_CRYPTED=

# Wifi. These end up on the installer's kernel command line, not in the
# preseed - the preseed is fetched over the network, so the network has to be
# up before it can be read.
WIFI_SSID=
WIFI_PASS=

# The wireless interface name on the TARGET machine, e.g. wlp2s0. Optional but
# recommended: netcfg's `auto` picks the first interface with a carrier, and
# wifi has none until it associates. Find it from the installer's own shell
# (Ctrl-Alt-F2, then `ip link`), or leave blank and pick from the prompt.
WIFI_IFACE=
