# metal/.env - the settings for ONE physical box. Copy to .env and fill in.
#
# Read by (all three, via lib.sh read_env):
#   build-iso.sh      builds the USB installer
#   serve-preseed.sh  serves the preseed the installer fetches
#   provision.sh      runs postinstall.sh on the installed box, then asserts
#
# .env is gitignored and must stay that way: it holds a password hash and a
# wifi passphrase. It is parsed literally, not sourced as shell - values are
# taken exactly as written, so a hash full of '$' needs no escaping and quotes
# are optional. An unrecognised key is an error, never a silently ignored line.
#
# FORGETTING A SETTING NEVER SWITCHES SOMETHING ON (#329). Required settings
# stop the script with a message; optional ones default to the safe choice.

#------------------------------------------------------------------------------
# Identity - REQUIRED
#------------------------------------------------------------------------------
# The box's hostname; it answers as <SERVER_NAME>.local. No default: forgetting
# it used to install a second "debbie" and point provision.sh at the live box.
# Read by: all three.
SERVER_NAME=

# The account that gets sudo and the SSH key. Default: srv.
# Read by: all three.
DEPLOY_USER=srv

# sha512-crypt hash for DEPLOY_USER's password (console login only - SSH is
# keys only). Generate with: openssl passwd -6
# Read by: serve-preseed.sh. Required; it refuses to run without one.
PASSWORD_CRYPTED=

#------------------------------------------------------------------------------
# Roles - what this box DOES. Unset, empty or `no` = OFF.
#------------------------------------------------------------------------------
# Every box tracks the `release` branch and can be reached over ngrok. Roles
# switch on the rest. Read by: provision.sh, which passes them to
# postinstall.sh. Every provisioning run makes the box match this file, so a
# role missing here is switched OFF on the box.
#
# Runs the sites (`yarn prod:docker`) and redeploys when `release` moves.
# Without ROLE_TUNNEL the sites are published on the LAN, for local use.
#ROLE_WEBSERVER=yes
#
# Runs the Cloudflare tunnel: the internet reaches this box. Requires
# ROLE_WEBSERVER=yes, and puts the sites on loopback only. EXACTLY ONE box may
# have it - the public sites keep their data in SQLite on that box.
#ROLE_TUNNEL=yes

#------------------------------------------------------------------------------
# Wifi - read by build-iso.sh and serve-preseed.sh
#------------------------------------------------------------------------------
# These end up on the installer's kernel command line, not in the preseed -
# the preseed is fetched over the network, so the network has to be up before
# it can be read. Required.
WIFI_SSID=
WIFI_PASS=

# The wireless interface name on the TARGET machine, e.g. wlp2s0. Optional but
# recommended: netcfg's `auto` picks the first interface with a carrier, and
# wifi has none until it associates. Find it from the installer's own shell
# (Ctrl-Alt-F2, then `ip link`), or leave blank and pick from the prompt.
WIFI_IFACE=

#------------------------------------------------------------------------------
# Optional
#------------------------------------------------------------------------------
# Private key for the box's SSH login. Default: metal/work/id_ed25519, which
# serve-preseed.sh generates on first use. Read by: serve-preseed.sh (puts the
# public half on the box) and provision.sh (logs in with it).
SSH_KEY=

# Source netinst ISO. Default: the newest debian-*-amd64-netinst.iso in
# metal/work/ or ~/Downloads/. Read by: build-iso.sh.
ISO=

# Port the preseed is served on, and the address the target should fetch from
# if it cannot be detected. Read by: serve-preseed.sh, build-iso.sh.
PORT=8000
SERVE_IP=

# Not a .env key: `HOST=<ip> ./provision.sh` is the fallback address when
# <SERVER_NAME>.local does not resolve from your laptop.
