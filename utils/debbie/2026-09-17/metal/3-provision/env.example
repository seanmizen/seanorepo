# 3-provision: runs postinstall.sh on the installed box, then asserts.
# Copy to <box>.env (gitignored). Run: ./provision.sh <box>
# Only these keys. Anything else = error. Literal, not sourced.
# Fallback address, not a key: HOST=<ip> ./provision.sh <box>

# REQUIRED. Box to dial as <name>.local. Must match the other steps.
SERVER_NAME=
# Account to log in as. Default srv.
DEPLOY_USER=srv
# SSH key to log in with. Default metal/work/id_ed25519.
SSH_KEY=

# ROLES. Unset/empty/no = OFF. Each run makes the box match this file.
# Runs the sites. Without TUNNEL: published on LAN.
#ROLE_WEBSERVER=yes
# Runs Cloudflare tunnel. Needs WEBSERVER. Sites on loopback. ONE box only.
#ROLE_TUNNEL=yes
