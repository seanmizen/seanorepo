# Edit that file, not this copy. - REQ-SERVER-015
[Unit]
Description=Install a new cloudflared or ngrok when the version is 7 days old
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# root: the script runs apt-get and restarts custom-cloudflared.service.
User=root
ExecStart=${VENDOR_UPGRADE_SCRIPT}
# A download and an install of two packages, plus a wait of up to 600s for the
# dpkg lock. Anything longer than this is hung.
TimeoutStartSec=900

# No [Install] section. custom-vendor-upgrade.timer owns this unit.
