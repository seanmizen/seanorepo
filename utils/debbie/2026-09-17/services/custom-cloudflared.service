# Written by payload/setup-server-environment.sh from services/custom-cloudflared.service.
# Edit that file, not this copy. - REQ-NETWORK-001
[Unit]
Description=Cloudflare tunnel - public ingress for every site this host serves
Documentation=https://github.com/seanmizen/seanorepo/issues/280
# The tunnel's first act is to dial out to Cloudflare, so it wants a route.
After=network-online.target
Wants=network-online.target

# REFUSE TO START. DO NOT FAIL IN A LOOP. A provisioned machine whose tunnel
# nobody set up by hand has neither of these paths. That is a normal first-boot
# state. It is not an error. When a condition is not met, systemd logs one line
# and leaves the unit inactive. That does NOT count as a failure, does not
# trigger Restart=, and cannot fill the journal. A start without credentials is
# an authentication failure every RestartSec, with no end. It floods the
# journal, even with the journal size cap (REQ-SERVER-007). It also hides the
# one fact that matters: nobody put the credentials on this machine.
ConditionPathExists=${CLOUDFLARED_CONFIG}
ConditionDirectoryNotEmpty=${CLOUDFLARED_CREDS_DIR}
# The role (REQ-SERVER-014). Credentials alone are not enough. A machine that
# holds a copy of them without the tunnel role must not pull public traffic.
ConditionPathExists=${ROLES_DIR}/tunnel

# The backstop for a failure the conditions cannot see - credentials that are
# present but rejected, or a config.yml that does not parse. Five attempts in
# ten minutes, then systemd gives up and leaves the unit in `failed`, which is
# a state `systemctl status` reports and a human can find. Without this,
# Restart=on-failure means "retry every ten seconds until the disk fills".
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=simple
User=${DEPLOY_USER}
# Required. See the WorkingDirectory note in the tunnel section of
# setup-server-environment.sh. config.yml's credentials-file is a relative
# path, and cloudflared resolves it from this directory.
WorkingDirectory=${CLOUDFLARED_DIR}
ExecStart=/usr/bin/cloudflared --no-autoupdate --config ${CLOUDFLARED_CONFIG} tunnel run
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
