# Written by payload/setup-server-environment.sh from services/custom-net-failover.timer.
# Edit that file, not this copy. - REQ-NETWORK-003
[Unit]
Description=Check every minute that the default route still reaches a gateway
Documentation=https://github.com/seanmizen/seanorepo/issues/281

[Timer]
# One minute, because this period is the outage clock. On 2026-08-14,
# seanmizen.com was down for as long as nobody looked at it. A healthy run is
# silent and costs two pings, so a short period costs almost nothing.
OnBootSec=1min
OnUnitActiveSec=1min
# No batching. AccuracySec is 1s here, and 30s on the release poller. If
# systemd coalesced this timer with other timers, it could defer the one check
# that decides whether the machine is reachable at all.
AccuracySec=1s
Unit=custom-net-failover.service

[Install]
WantedBy=timers.target
