# The secret files that a machine with the webserver role must have
# (REQ-SERVER-022). deploy.sh reads this list before `yarn prod:docker`. It
# stops with an error that names each file that is missing, or that the
# deploy user cannot read.
#
# One absolute path on each line. A line that starts with # is a comment.
# The README table "Server secrets" names the values in each file, and where
# to issue each one again. The crm demo files are not here: the demo is off
# without them (apps/crm/scripts/prod-docker.sh).
/etc/seanorepo/autosam.env
/etc/seanorepo/caroline.env
/etc/seanorepo/crm.env
/etc/seanorepo/crm-r2.env
/etc/seanorepo/inside.env
