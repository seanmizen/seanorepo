# Written by payload/setup-server-environment.sh from services/custom-vpn-sync.service.
# Edit that file, not this copy. - REQ-NETWORK-006, REQ-NETWORK-007
[Unit]
Description=Keep the VPN address, forwarding rules and vpn.seanmizen.com AAAA record in line with the network
# The role decides, like every role unit (REQ-SERVER-014). A host without
# the role skips every start.
ConditionPathExists=${ROLES_DIR}/vpn
# No After=network-online.target, for the reason in custom-net-failover.service.
# The script finds a network that is not there, and changes nothing.
After=wg-quick@wg0.service

[Service]
Type=oneshot
# root: the script adds addresses, routes and firewall rules, and reads the
# root-only DNS token.
User=root
ExecStart=${VPN_SYNC_SCRIPT}
# Two API calls of at most 15s each, plus `ip` and `iptables`. A longer run is
# hung, and hung runs on a 2-minute timer stack up.
TimeoutStartSec=60

# No [Install] section. custom-vpn-sync.timer owns this unit.
