# Managed by utils/debbie/2026-09-17/payload/setup-developer-environment.sh.
# Rewritten whole on every run: edits here are lost. Put local settings in
# ~/.config/ghostty/config.local, which loads last and is never touched.

# Material Design colours, as sRGB. windows-terminal.json uses the same values.
background = #263238
foreground = #eceff1
cursor-color = #eeeeee
cursor-text = #000000
selection-background = #607d8b
selection-foreground = #eceff1
palette = 0=#546e7a
palette = 1=#ff5252
palette = 2=#69f0ae
palette = 3=#ffd740
palette = 4=#40c4ff
palette = 5=#ff4081
palette = 6=#64fcda
palette = 7=#ffffff
palette = 8=#b0bec5
palette = 9=#ff8a80
palette = 10=#b9f6ca
palette = 11=#ffe57f
palette = 12=#80d8ff
palette = 13=#ff80ab
palette = 14=#a7fdeb
palette = 15=#ffffff
# Bold text uses the bright palette colours.
bold-color = bright
window-colorspace = display-p3

font-family = Monaco
font-size = 12
cursor-style-blink = false
confirm-close-surface = false

# Every host has a terminfo entry for xterm-256color. A host without an entry
# for xterm-ghostty (Debian has none) redraws the zsh line wrong over ssh.
term = xterm-256color

# Natural Text Editing: Option moves and deletes by word, Command by line.
keybind = alt+left=esc:b
keybind = alt+right=esc:f
keybind = alt+backspace=text:\x1b\x7f
keybind = super+left=text:\x01
keybind = super+right=text:\x05
keybind = super+backspace=text:\x15

config-file = ?config.local
