# 1-build-iso: builds the USB installer ISO for one box.
# Copy to <box>.env (gitignored). Run: ./build-iso.sh <box>
# Only these keys. Anything else = error. Literal, not sourced.

# REQUIRED. Hostname baked into the installer. Must match the other steps.
SERVER_NAME=
# Account created by the installer. Default srv.
DEPLOY_USER=srv
# REQUIRED. Wifi, baked into the installer kernel cmdline.
WIFI_SSID=
WIFI_PASS=
# Target wifi interface, e.g. wlp2s0. Blank = pick at the prompt.
WIFI_IFACE=
# Where the installer fetches the preseed: this laptop, step 2's port.
PORT=8000
SERVE_IP=
# Source netinst ISO. Default newest in working/ or ~/Downloads/.
ISO=
