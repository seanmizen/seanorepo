# 1-build-iso: builds ONE USB installer that installs any machine.
# Copy to .env (gitignored). Run: ./build-iso.sh
# Only these keys. Anything else = error. Literal, not sourced.
#
# Nothing here names a machine - #376. The installer calls itself
# debbie-installer, and 2-serve-preseed names the machine it installs. So one
# stick serves every machine and never needs writing again.
#
# Per HOUSE: WIFI_SSID, WIFI_PASS.  Per LAPTOP: PORT, SERVE_IP, ISO.
# Per MACHINE: WIFI_IFACE, and only that one.

# IGNORED since #376, and read only so an older <machine>.env still parses.
SERVER_NAME=
# Account created by the installer. Default srv.
DEPLOY_USER=srv
# REQUIRED. Wifi, baked into the installer kernel cmdline.
WIFI_SSID=
WIFI_PASS=
# Target wifi interface, e.g. wlp2s0. Blank = the installer asks, which is one
# keystroke and the price of a generic stick. A machine with ethernet needs no
# wifi keys at all: netcfg takes the first interface with a carrier.
WIFI_IFACE=
# Where the installer fetches the preseed: this laptop, step 2's port.
PORT=8000
SERVE_IP=
# Source netinst ISO. Default newest in working/ or ~/Downloads/.
ISO=
