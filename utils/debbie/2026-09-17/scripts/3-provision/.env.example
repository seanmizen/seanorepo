# 3-provision: runs setup-server-environment.sh on the installed machine, then asserts.
# Copy to <machine>.env (gitignored). Run: ./provision.sh <machine>
# Only these keys. Anything else = error. Literal, not sourced.
# Fallback address, not a key: HOST=<ip> ./provision.sh <machine>

# REQUIRED. Machine to dial as <name>.local. Must match the other steps.
SERVER_NAME=
# Account to log in as. Default srv.
DEPLOY_USER=srv
# Private key to log in with. Default ~/.ssh/seanorepo-admin, the key that
# every machine this generation installs trusts. Set it only to reach a
# machine that has a different key.
SSH_KEY=

# ROLES. Unset/empty/no = OFF. Each run makes the machine match this file.
# Runs the sites. Without TUNNEL: published on LAN.
#ROLE_WEBSERVER=yes
# Runs Cloudflare tunnel. Needs WEBSERVER. Sites on loopback. ONE machine only.
#ROLE_TUNNEL=yes

# WIFI. Networks this machine joins, as numbered pairs from 1 to 4. Unset = no
# wifi change: the machine keeps the addressing it has. The machine stores each
# password as a hashed PSK, never in plaintext. A box installed over ethernet
# has no wifi until a network is named here. A WPA2 password is 8 to 63
# characters. An SSID with a space or a quote is fine; write it unquoted.
#WIFI_1_SSID=
#WIFI_1_PASS=
#WIFI_2_SSID=
#WIFI_2_PASS=
#WIFI_3_SSID=
#WIFI_3_PASS=
#WIFI_4_SSID=
#WIFI_4_PASS=
