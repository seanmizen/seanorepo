# 2-serve-preseed: serves the preseed the installer fetches, for one machine.
# Copy to <machine>.env (gitignored). Run: ./serve-preseed.sh <machine>
# Only these keys. Anything else = error. Literal, not sourced.

# REQUIRED. Hostname the install sets. Must match the other steps.
SERVER_NAME=
# Account the install creates. Default srv.
DEPLOY_USER=srv
# REQUIRED. Console password hash for DEPLOY_USER: openssl passwd -6
PASSWORD_CRYPTED=
# REQUIRED. Wifi the installed machine keeps. Same as step 1.
WIFI_SSID=
WIFI_PASS=
WIFI_IFACE=
# Port to serve on; address to announce if autodetect fails. Same as step 1.
PORT=8000
SERVE_IP=
# IGNORED since #369, and kept only so an older <machine>.env still parses.
# The machine is authorised for the admin key committed at
# payload/seanorepo-admin.pub. Nothing is generated per checkout any more.
SSH_KEY=
