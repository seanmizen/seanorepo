# 2-serve-preseed: serves the preseed the installer fetches, for one box.
# Copy to <box>.env (gitignored). Run: ./serve-preseed.sh <box>
# Only these keys. Anything else = error. Literal, not sourced.

# REQUIRED. Hostname the install sets. Must match the other steps.
SERVER_NAME=
# Account the install creates. Default srv.
DEPLOY_USER=srv
# REQUIRED. Console password hash for DEPLOY_USER: openssl passwd -6
PASSWORD_CRYPTED=
# REQUIRED. Wifi the installed box keeps. Same as step 1.
WIFI_SSID=
WIFI_PASS=
WIFI_IFACE=
# Port to serve on; address to announce if autodetect fails. Same as step 1.
PORT=8000
SERVE_IP=
# SSH key authorised on the box. Default working/id_ed25519 (generated).
SSH_KEY=
