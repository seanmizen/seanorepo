# ---------------------------------------------------------------------------
# tty-dashboard — copy to .env. .env is gitignored.
#
# Every key is read by source/, through process.env, at run time. A switch
# reads 'true' as on and anything else, including unset, as off.
# ---------------------------------------------------------------------------

# --- Display -----------------------------------------------------------------
# Adds the long description under each TfL line status.
SHOW_TFL_DESCRIPTION=false

# Rail departures to list. More than the terminal is tall will be cut off.
MAX_RAIL_DEPARTURES=4

# --- Timing (seconds) --------------------------------------------------------
# How often to re-scrape TfL and National Rail.
REFRESH_INTERVAL=120
# How often to redraw. Cheap: it repaints from the last scrape.
SCREEN_REFRESH_INTERVAL=10

# --- Development -------------------------------------------------------------
# Serves fixtures instead of scraping, so the dashboard runs offline.
USE_TEST_DATA=true
# Prints the scraper's own state into the dashboard.
SHOW_DEBUG_INFO=true

# --- Secret modes ------------------------------------------------------------
# Comma-separated, in any order. Unknown names are ignored, so an empty value
# turns all of them off. source/app.tsx recognises exactly these five:
#   youtube  an ASCII YouTube player
#   spoons   the nearest Wetherspoons, from SPOONS_LAT and SPOONS_LNG
#   tetris   Tetris
#   spooky   Halloween styling
#   xmas     rotating Christmas quotes
SECRET_MODES=youtube,spoons,tetris,spooky

# --- Spoons finder -----------------------------------------------------------
# Only read when SECRET_MODES includes 'spoons'. SPOONS_LOCATION is the label
# shown; the two coordinates are what the search actually uses.
SPOONS_LOCATION=putney
SPOONS_LAT=51.462506
SPOONS_LNG=-0.215772
