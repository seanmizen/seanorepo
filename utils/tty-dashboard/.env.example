# tty-dashboard. Copy to .env. .gitignore excludes .env.
# source/ reads every key here through process.env at run time.
# A switch reads 'true' as on. Any other value, and unset, reads as off.

# Adds the long description under each TfL line status.
SHOW_TFL_DESCRIPTION=false
# The number of rail departures to list. The terminal height cuts off the rest.
MAX_RAIL_DEPARTURES=4

# Seconds between scrapes of TfL and National Rail.
REFRESH_INTERVAL=120
# Seconds between redraws. A redraw repaints the last scrape.
SCREEN_REFRESH_INTERVAL=10

# 'true' serves fixtures instead of scraping, so the dashboard runs offline.
USE_TEST_DATA=true
# 'true' prints the scraper state into the dashboard.
SHOW_DEBUG_INFO=true

# Comma-separated, in any order. source/app.tsx ignores an unknown name, so an
# empty value turns every mode off. app.tsx accepts these five names:
#   youtube  an ASCII YouTube player
#   spoons   the nearest Wetherspoons, from SPOONS_LAT and SPOONS_LNG
#   tetris   Tetris
#   spooky   Halloween styling
#   xmas     rotating Christmas quotes
SECRET_MODES=youtube,spoons,tetris,spooky

# app.tsx reads these three keys only when SECRET_MODES includes 'spoons'.
# SPOONS_LOCATION is the label. The search uses the two coordinates.
SPOONS_LOCATION=putney
SPOONS_LAT=51.462506
SPOONS_LNG=-0.215772
