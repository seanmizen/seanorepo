#!/bin/sh
# Start the winlike desktop in a window (nested in WSLg or any Wayland session).
# Close the window, or use Win+X > Sign out, to stop it.
#   winlike                   1280x720 window
#   winlike --size 1600x900   window of that size
#   winlike --fullscreen      window of the same size as the Windows primary
#                             monitor. To put it at the top-left corner and
#                             over the Windows taskbar, press Ctrl+Alt+Enter
#                             (windows/winlike-capture.ahk).
# Other arguments go to labwc.
set -eu

case "${1:-}" in
  --size)
    WINLIKE_SIZE=$2
    shift 2
    ;;
  --fullscreen)
    # The size of the monitor at 0,0 (the Windows primary monitor), from WSLg.
    WINLIKE_SIZE=$(python3 -c '
import gi
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk
d = Gdk.Display.get_default()
mons = [d.get_monitor(i).get_geometry() for i in range(d.get_n_monitors())]
g = next((m for m in mons if m.x == 0 and m.y == 0), mons[0])
print(f"{g.width}x{g.height}")
' 2>/dev/null || echo 1920x1080)
    shift
    ;;
esac
# ~/.config/labwc/autostart reads WINLIKE_SIZE and sets the output size.
export WINLIKE_SIZE="${WINLIKE_SIZE:-}"

# WSLg mounts /tmp/.X11-unix read-only and without the sticky bit. Xwayland in
# labwc needs to write its socket there.
if [ -d /mnt/wslg ] && ! touch /tmp/.X11-unix/.winlike-check 2>/dev/null; then
  echo "winlike: make /tmp/.X11-unix writable for Xwayland (sudo)"
  sudo mount -o remount,rw /tmp/.X11-unix
  sudo chmod +t /tmp/.X11-unix
fi
rm -f /tmp/.X11-unix/.winlike-check

# Apps that the session starts (Ghostty from Win+X, for example) open in ~.
cd "$HOME"
exec dbus-run-session labwc "$@"
