<?xml version="1.0" encoding="UTF-8"?>
<!-- winlike: menus that copy Windows 10. -->
<openbox_menu>

<!-- Window menu: Alt+Space, right-click on the title bar, or click on the window icon -->
<menu id="client-menu">
  <item label="Restore"><action name="UnMaximize" /></item>
  <item label="Move"><action name="Move" /></item>
  <item label="Size"><action name="Resize" /></item>
  <item label="Minimize"><action name="Iconify" /></item>
  <item label="Maximize"><action name="Maximize" /></item>
  <separator />
  <item label="Close        Alt+F4"><action name="Close" /></item>
</menu>

<!-- Quick Link menu: Win+X -->
<menu id="root-menu">
  <item label="Task Manager"><action name="Execute" command="qps" /></item>
  <item label="Settings"><action name="Execute" command="lxqt-config" /></item>
  <item label="File Explorer"><action name="Execute" command="pcmanfm-qt" /></item>
  <item label="Terminal"><action name="Execute" command="qterminal" /></item>
  <item label="Run"><action name="Execute" command="lxqt-runner" /></item>
  <separator />
  <item label="Sign out"><action name="Exit" /></item>
  <item label="Desktop"><action name="Execute" command="winlike-panel showdesktop/show_hide" /></item>
</menu>

</openbox_menu>
