# winlike: environment for the labwc session and every app it starts.
XDG_SESSION_TYPE=wayland
XDG_CURRENT_DESKTOP=LXQt:wlroots
QT_QPA_PLATFORM=wayland
QT_QPA_PLATFORMTHEME=lxqt
XCURSOR_THEME=Breeze_Light
XCURSOR_SIZE=24
# Mesa in Debian 13 selects llvmpipe (CPU) on WSLg. This selects the GPU (D3D12).
GALLIUM_DRIVER=d3d12
# winlike: F13 to F18 from winlike-capture.ahk become Win, Tab, Esc, Space,
# PrtScn and F4 (~/.config/xkb/symbols/winlike).
XKB_DEFAULT_OPTIONS=winlike:capture
