# Copy to ~/.config/seanorepo/cloudflare.secrets, fill in, then chmod 600.
# It lives outside the repo, so it cannot be committed, and every checkout
# shares it. The wrapper refuses a file that other users can read.

# Cloudflare API token. See README.md for the permissions.
CLOUDFLARE_API_TOKEN=

# Encrypts the committed state. At least 16 characters.
# Make one: openssl rand -base64 32
# Keep a copy where you keep other secrets. If you lose it, rebuild the
# state: see "Lost passphrase" in README.md.
TF_VAR_state_passphrase=
