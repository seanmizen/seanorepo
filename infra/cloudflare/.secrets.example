# Only for an apply by hand. CI applies from release with its own token, so
# a machine normally has no Cloudflare token. See README.md, "Apply by hand".
# Copy to ~/.config/seanorepo/cloudflare.secrets, fill in, then chmod 600.
# It lives outside the repo, so it cannot be committed, and every checkout
# shares it. The wrapper refuses a file that other users can read. Delete it
# after the apply.

# Cloudflare API token. See README.md for the permissions.
CLOUDFLARE_API_TOKEN=
