// The tailnet policy. OpenTofu applies this file (main.tf). An edit in the
// admin console is lost at the next apply.
//
// Sean's own devices (autogroup:member) reach everything: each machine and
// both LANs. A tagged machine reaches nothing. asus faces the internet
// through the Cloudflare tunnel, so if someone takes it, they get no way
// to the Mac, the phone, the NAS or Caroline's LAN. Traffic from Sean's
// devices through a subnet router still works: the router only forwards it.
{
	"tagOwners": {
		// asus and minix.
		"tag:server": ["autogroup:admin"],
		// basecamp, Caroline's NAS.
		"tag:nas": ["autogroup:admin"],
	},

	"grants": [
		{"src": ["autogroup:member"], "dst": ["*"], "ip": ["*"]},
	],

	// Tailscale refuses a policy that fails a test. The 100.x addresses are
	// tailnet addresses: 100.114.218.110 is the Mac.
	"tests": [
		{
			"src":    "9mazes@gmail.com",
			"accept": ["tag:server:22", "tag:nas:5001", "tag:nas:445", "10.9.8.1:443", "10.0.1.1:443"],
		},
		{
			"src":  "tag:server",
			"deny": ["100.114.218.110:22", "tag:server:22", "tag:nas:445", "10.9.8.1:443", "10.0.1.1:443"],
		},
		{
			"src":  "tag:nas",
			"deny": ["100.114.218.110:22", "tag:server:22", "10.9.8.1:443", "10.0.1.1:443"],
		},
	],
}
