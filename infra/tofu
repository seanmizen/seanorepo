#!/usr/bin/env bash
# Runs the pinned OpenTofu for one stack (a directory under infra/).
# Downloads it on first use, checks the SHA-256 against the sums below, and
# keeps it in infra/.tofu/ (gitignored). Loads the Cloudflare token from
# ~/.config/seanorepo/cloudflare.secrets. The github stack takes its token
# from your gh login (`gh auth token`).
#
# `release` is what is live, so the commands that change live settings or
# the state (apply, destroy, import, state rm/mv/push) run only from a
# checkout of `release` that is clean and equal to origin/release. plan
# runs anywhere.
#   infra/tofu cloudflare plan      infra/tofu github apply
# Each stack also has ./tofu, which calls this with its own name.
set -euo pipefail

VERSION=1.12.6
declare -A SUMS=(
  [linux_amd64]=5dc43da4f750f33873dc25e94587128709e819e544b7be9016b255316153c3a8
  [linux_arm64]=e573979ba68a17fe7b881752051a694a7efcd970e39521f6a25775197861ed4d
  [darwin_amd64]=166388e5feed47e107e11721b6366bf91d21e47eccbced75f3cbe0c7184ffd9b
  [darwin_arm64]=e083ee43790ab9e19ad66d9933e24a7244a1412e1d5728f37999ae2163fdac95
)

here="$(cd "$(dirname "$0")" && pwd)"
stack="${1:-}"
if [ -z "$stack" ] || [ ! -f "$here/$stack/versions.tf" ]; then
  echo "usage: infra/tofu <stack> <command>. Stacks: $(cd "$here" && ls -d */ | tr -d / | tr '\n' ' ')" >&2
  exit 2
fi
shift

case "${1:-}" in
  apply | destroy | import | state)
    if [ "${1:-}" != state ] || [[ "${2:-}" =~ ^(rm|mv|push|replace-provider)$ ]]; then
      repo="$(git -C "$here" rev-parse --show-toplevel)"
      branch="$(git -C "$repo" rev-parse --abbrev-ref HEAD)"
      if [ "$branch" != release ]; then
        echo "tofu: $1 runs only from a checkout of release. This checkout is on $branch. See infra/cloudflare/README.md." >&2
        exit 1
      fi
      if [ -n "$(git -C "$repo" status --porcelain)" ]; then
        echo "tofu: the checkout has changes that are not committed. Commit or remove them, then run $1 again." >&2
        exit 1
      fi
      git -C "$repo" fetch --quiet origin release
      if [ "$(git -C "$repo" rev-parse HEAD)" != "$(git -C "$repo" rev-parse origin/release)" ]; then
        echo "tofu: this checkout is not equal to origin/release. Run git pull --ff-only, then run $1 again." >&2
        exit 1
      fi
    fi
    ;;
esac

os="$(uname -s | tr '[:upper:]' '[:lower:]')"
arch="$(uname -m)"
case "$arch" in x86_64) arch=amd64 ;; aarch64 | arm64) arch=arm64 ;; esac
platform="${os}_${arch}"
sum="${SUMS[$platform]:-}"
[ -n "$sum" ] || { echo "tofu: no pinned build for $platform" >&2; exit 1; }

bin="$here/.tofu/$VERSION/tofu"
if [ ! -x "$bin" ]; then
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  zip="tofu_${VERSION}_${platform}.zip"
  echo "tofu: downloading OpenTofu $VERSION ($platform)" >&2
  curl -fsSL -o "$tmp/$zip" "https://github.com/opentofu/opentofu/releases/download/v$VERSION/$zip"
  got="$( (sha256sum "$tmp/$zip" 2>/dev/null || shasum -a 256 "$tmp/$zip") | cut -d' ' -f1)"
  if [ "$got" != "$sum" ]; then
    echo "tofu: checksum mismatch for $zip. Expected $sum, got $got." >&2
    exit 1
  fi
  mkdir -p "$(dirname "$bin")"
  (cd "$tmp" && unzip -q "$zip" tofu)
  mv "$tmp/tofu" "$bin"
  chmod +x "$bin"
fi

# The secrets file holds CLOUDFLARE_API_TOKEN.
# It lives outside the repo, so every checkout and worktree shares one copy.
# It must not be readable by other users. See README.md.
secrets="${CLOUDFLARE_SECRETS:-$HOME/.config/seanorepo/cloudflare.secrets}"
if [ "$stack" = github ] && [ -z "${GITHUB_TOKEN:-}" ]; then
  GITHUB_TOKEN="$(gh auth token)" || { echo "tofu: the github stack needs gh auth login" >&2; exit 1; }
  export GITHUB_TOKEN
fi
if [ -f "$secrets" ]; then
  mode="$(stat -c %a "$secrets" 2>/dev/null || stat -f %Lp "$secrets")"
  if [ "$mode" != 600 ]; then
    echo "tofu: $secrets has mode $mode. Run: chmod 600 $secrets" >&2
    exit 1
  fi
  set -a
  # shellcheck source=/dev/null
  . "$secrets"
  set +a
fi

cd "$here/$stack"
exec "$bin" "$@"
